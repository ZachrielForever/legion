# ==============================================================================
# legion lorica - travel node / sister to aegis
#
# Thin mask over bazzite (KDE, AMD, no NVIDIA, no dx). Upstream provides
# the desktop and gaming stack. Lorica travels light - mutations minimal.
# Branch is parameterized: stable / testing / unstable mirror upstream.
# ==============================================================================

ARG BASE_TAG=stable

FROM scratch AS ctx
COPY build_files /
COPY system_files /system_files

FROM ghcr.io/ublue-os/bazzite:${BASE_TAG}

### MODIFICATIONS
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    BASE_TAG=${BASE_TAG} bash /ctx/build.sh

### LINTING
RUN bootc container lint