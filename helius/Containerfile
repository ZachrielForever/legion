# ==============================================================================
# legion helius - daily driver / fleet orchestrator
#
# Thin mask over bazzite-dx-nvidia. Upstream provides the desktop,
# NVIDIA open drivers, DX tooling, VMs, and containers. No additions
# unless dire need - Helius streams work to nodes, it doesn't hoard it.
# ==============================================================================

FROM scratch AS ctx
COPY build_files /
COPY system_files /system_files

FROM ghcr.io/ublue-os/bazzite-dx-nvidia:stable

### MODIFICATIONS
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    bash /ctx/build.sh

### LINTING
RUN bootc container lint