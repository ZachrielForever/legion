# legion turma:vesta - private (tailnet-only) web/file server
#
# Sibling of lumen minus the WAN hardening. Serves over the tailnet
# only; nothing here faces the public internet.

FROM scratch AS ctx
COPY build_files /
COPY system_files /system_files

# Base Image
FROM ghcr.io/zachrielforever/l-turma:platform

### MODIFICATIONS
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    /bin/bash /ctx/build.sh

### LINTING
RUN bootc container lint