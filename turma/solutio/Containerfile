# legion turma:lumen - public WAN web/file server (bastion)
#
# The sacrificial node. Serves HTTP/HTTPS to the world via Caddy,
# holds nothing precious, trusts nobody, and fails closed.

FROM scratch AS ctx
COPY build_files /
COPY system_files /system_files

# Base Image
FROM ghcr.io/zachrielforever/l-turma:platform

### MODIFICATIONS
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    /ctx/build.sh

### LINTING
RUN bootc container lint