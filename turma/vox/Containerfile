# legion turma:vox - private media server
#
# Media serving over Tailscale only. Image carries drivers/codecs;
# media services (Jellyfin) run as containers via quadlet.
# UHD 630 VA-API for hardware transcoding.

FROM scratch AS ctx
COPY build_files /
COPY system_files /system_files

# Base Image
FROM ghcr.io/zachrielforever/l-turma:platform

### MODIFICATIONS
RUN --mount=type=bind,from=ctx,source=/,target=/ctx \
    --mount=type=cache,dst=/var/cache \
    --mount=type=cache,dst=/var/log \
    --mount=type=tmpfs,dst=/tmp \
    /bin/bash /ctx/build.sh

### LINTING
RUN bootc container lint